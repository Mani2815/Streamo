# ==========================================
# LOCAL DEVELOPMENT (Docker Compose)
# ==========================================
POSTGRES_USER=streamo_user
POSTGRES_PASSWORD=streamo_password
STREAMO_DB=streamo
AIRFLOW_DB=airflow

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ==========================================
# PUBLIC DEMO / RENDER DEPLOYMENT
# ==========================================
# DATABASE_URL is required for Render/public deployments using Supabase or managed Postgres.
# Do NOT place your actual password here if committing to version control.
# Instead, add it to your Render Environment Variables directly.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL=

# KAFKA_BOOTSTRAP_SERVERS is optional for the public UI (which is read-only for demo data),
# but required if you intend to create new streaming sources from the Control Plane.
# KAFKA_BOOTSTRAP_SERVERS=
