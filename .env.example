# ==========================================
# LOCAL DEVELOPMENT (Docker Compose)
# ==========================================
POSTGRES_USER=streamo_user
POSTGRES_PASSWORD=streamo_password
STREAMO_DB=streamo
AIRFLOW_DB=airflow

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ==========================================
# RENDER DEPLOYMENT
# ==========================================
# DATABASE_URL is strictly required. Point it to a managed PostgreSQL database.
# Format: postgresql://user:password@host:port/dbname
# DATABASE_URL=

# KAFKA_BOOTSTRAP_SERVERS is optional for the UI, but required to create new sources.
# KAFKA_BOOTSTRAP_SERVERS=
